<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FBF4DF"
    android:fitsSystemWindows="true">

    <!-- ===== ПРОКРУЧИВАЕМАЯ ЧАСТЬ (Весь контент) ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp"> <!-- Отступ снизу, чтобы контент не прилипал к панели -->

            <!-- ШАПКА -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_main_pet_small"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_pet_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Финни"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2C3E50" />
                </LinearLayout>

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="8dp"
                    android:text="Период: 1 из 5"
                    android:textSize="14sp"
                    android:textColor="#7F8C8D"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_settings"
                    android:background="@drawable/bg_card"
                    android:scaleType="centerInside"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- БЛОКИ ФИНАНСОВ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_block_blue"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Могу потратить"
                        android:textSize="12sp"
                        android:textColor="#2980B9"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2156 монет"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2980B9" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="24sp"
                    android:textColor="#7F8C8D"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_block_purple"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Накопления"
                        android:textSize="12sp"
                        android:textColor="#8E44AD"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_savings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2740 монет"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#8E44AD" />
                </LinearLayout>
            </LinearLayout>

            <!-- ТЕКУЩЕЕ ЗАДАНИЕ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Текущее задание:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#7F8C8D"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_task_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📌 Первый доход (+40 монет)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:layout_marginBottom="12dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_do_task"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Выполнить"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#C9A7E8"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- ПИТОМЕЦ ПО ЦЕНТРУ -->
            <ImageView
                android:id="@+id/iv_main_pet"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:scaleType="centerInside" />

            <!-- ТЕКУЩАЯ ЦЕЛЬ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Текущая цель:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#7F8C8D"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_goal_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Велосипед"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/pb_goal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:progress="50"
                    android:max="100"
                    android:progressTint="#66BB6A"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_select_goal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Выбрать цель"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#C9A7E8"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- СОСТОЯНИЕ ПИТОМЦА -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Состояние Финни:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#7F8C8D"
                    android:layout_marginBottom="12dp" />

                <!-- Настроение -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="😊 Настроение:"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                        <TextView
                            android:id="@+id/tv_pet_mood_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="хорошее"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pb_pet_mood"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="70"
                        android:max="100"
                        android:progressTint="#FFD93D" />
                </LinearLayout>

                <!-- Здоровье -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="❤️ Здоровье:"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                        <TextView
                            android:id="@+id/tv_pet_health_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="хорошее"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pb_pet_health"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="80"
                        android:max="100"
                        android:progressTint="#FF6B6B" />
                </LinearLayout>

                <!-- Сытость -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🍖 Сытость:"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                        <TextView
                            android:id="@+id/tv_pet_hunger_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="средняя"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pb_pet_hunger"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="60"
                        android:max="100"
                        android:progressTint="#4ECDC4" />
                </LinearLayout>

                <!-- Энергия -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ Энергия:"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                        <TextView
                            android:id="@+id/tv_pet_energy_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="средняя"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pb_pet_energy"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="65"
                        android:max="100"
                        android:progressTint="#95E1D3" />
                </LinearLayout>
            </LinearLayout>

            <!-- КНОПКА ДЕМО-РЕЖИМА -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_next_period"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:text="⏭ Завершить период (Демо)"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_gray"
                android:textColor="#757575" />

        </LinearLayout>
    </ScrollView>

    <!-- ===== ФИКСИРОВАННАЯ НИЖНЯЯ ПАНЕЛЬ ===== -->
    <LinearLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#FCE09F"
        android:elevation="8dp">

        <!-- 1. Бюджет -->
        <ImageButton
            android:id="@+id/btn_nav_budget"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:src="@drawable/ic_budget"
            android:backgroundTint="#FFEBBD"
            android:scaleType="centerInside"
            android:padding="12dp" />

        <!-- 2. Задания -->
        <ImageButton
            android:id="@+id/btn_nav_tasks"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:src="@drawable/ic_tasks"
            android:backgroundTint="#FFEBBD"
            android:scaleType="centerInside"
            android:padding="12dp" />

        <!-- 3. ДОМ (Центральная, увеличенная) -->
        <ImageButton
            android:id="@+id/btn_nav_home"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_home"
            android:backgroundTint="#F9CC61"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="-20dp"
            android:layout_marginBottom="-20dp"
            android:elevation="4dp" />

        <!-- 4. Покупки -->
        <ImageButton
            android:id="@+id/btn_nav_shop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:src="@drawable/ic_shop"
            android:backgroundTint="#FFEBBD"
            android:scaleType="centerInside"
            android:padding="12dp" />

        <!-- 5. Цели -->
        <ImageButton
            android:id="@+id/btn_nav_goals"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:src="@drawable/ic_goals"
            android:backgroundTint="#FFEBBD"
            android:scaleType="centerInside"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>