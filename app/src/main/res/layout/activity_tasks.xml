<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF4DF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Шапка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📚 Задания"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />

            <TextView
                android:id="@+id/tv_tasks_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_block_blue"
                android:text="💰 1000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2980B9"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
        <!-- Фильтры (только одна кнопка "Все") -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_filter_all"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Все задания"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:backgroundTint="#C9A7E8"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Карточка прогресса (как "План на период" в магазине) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Твой прогресс"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Выполнено заданий:"
                    android:textSize="14sp"
                    android:textColor="#7F8C8D" />

                <TextView
                    android:id="@+id/tv_tasks_completed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 из 6"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#66BB6A" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_tasks_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progressTint="#66BB6A" />
        </LinearLayout>

        <!-- Список заданий -->
        <LinearLayout
            android:id="@+id/tasks_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>