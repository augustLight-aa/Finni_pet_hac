<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF4DF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Шапка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎯 Моя цель"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />

            <TextView
                android:id="@+id/tv_goals_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_block_blue"
                android:text="💰 1000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2980B9"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>

        <!-- Текущая выбранная цель -->
        <LinearLayout
            android:id="@+id/card_current_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_goal_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="48sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_goal_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Велосипед"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_goal_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 из 2000 монет (0%)"
                android:textSize="16sp"
                android:textColor="#7F8C8D"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <ProgressBar
                android:id="@+id/pb_goal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginBottom="24dp"
                android:progressTint="#66BB6A" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_add_to_goal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Пополнить копилку"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_pill"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_withdraw_from_goal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Снять с накоплений"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:background="@drawable/bg_card"
                android:textColor="#7F8C8D" />
        </LinearLayout>

        <!-- Список доступных целей -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выбери новую цель:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/goals_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>